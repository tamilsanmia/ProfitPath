FROM node:22-alpine

WORKDIR /app

RUN corepack enable \
	&& mkdir -p /app/node_modules /app/.next /tmp /home/node/.cache/corepack \
	&& chown -R node:node /app /tmp /home/node/.cache

COPY --chown=node:node package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY --chown=node:node . .

EXPOSE 3000

CMD ["pnpm", "dev", "-H", "0.0.0.0", "-p", "3000"]
